    "state": "awaiting",
    "verified_by": null,
    "indexed_text": null,
    "frontier_row": "queued",
    "refetch_due": true
   }
  },
  {
   "id": "frontier-quorum-then-the-server-copy",
   "class": "frontier",
   "events": [
    "attest",
    "attest",
    "refetch_ok"
   ],
   "expect": {
    "state": "verified",
    "verified_by": "server",
    "indexed_text": "server",
    "frontier_row": "done",
    "refetch_due": false
   }
  },
