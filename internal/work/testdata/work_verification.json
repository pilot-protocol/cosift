  {
   "id": "frontier-one-attestation-waits-for-the-window",
   "class": "frontier",
   "events": [
    "attest"
   ],
   "expect": {
    "state": "awaiting",
    "verified_by": null,
    "indexed_text": null,
    "frontier_row": "queued",
    "refetch_due": false
   }
  },
