[Unit]
Description=cosift PULL-based self-updater (verify + swap + health-gate + rollback)
# Don't poll until the box is on the network and the serve unit is up; the
# updater health-gates the same service it restarts.
After=network-online.target cosift-serve.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
# Public verification key baked on the box. The matching private key lives
# only as the MINISIGN_SECRET_KEY GitHub Actions secret (CI signs releases).
Environment=COSIFT_REPO=pilot-protocol/cosift
Environment=COSIFT_BIN=/home/ubuntu/cosift
Environment=COSIFT_SERVICE=cosift-serve
Environment=COSIFT_PUBKEY=/etc/cosift/minisign.pub
Environment=COSIFT_HEALTH_URL=http://127.0.0.1:7777/healthz
# HNSW load was measured at ~511s on the 2026-07-23 restart and grows ~4s/day;
# 600 would auto-roll-back healthy releases within weeks.
Environment=COSIFT_HEALTH_TIMEOUT_S=1800
# Optional: drop a GITHUB_TOKEN here (or in a drop-in) to raise the API rate
# limit. Public releases work unauthenticated, so it's not required.
# Environment=GITHUB_TOKEN=
ExecStart=/home/ubuntu/scripts/cosift-self-update.sh
# Worst case is the health gate PLUS the rollback's second health gate
# (2 × COSIFT_HEALTH_TIMEOUT_S), with headroom — never let systemd kill a
# run mid-gate, or the new binary is left installed with no rollback.
TimeoutStartSec=5400
# A failed self-update (non-zero exit) is informational, not fatal for the
# box — the running service is unaffected (or already rolled back).
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
