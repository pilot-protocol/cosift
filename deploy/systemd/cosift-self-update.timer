[Unit]
Description=Poll for a newer signed cosift release every ~5 min

[Timer]
# Every five minutes in wall-clock time, including recovery after downtime.
# RandomizedDelaySec smears load off the GitHub API and avoids
# a thundering-herd if multiple boxes ever run this.
OnCalendar=*-*-* *:0/5:00 UTC
RandomizedDelaySec=60
AccuracySec=30s
Persistent=true
Unit=cosift-self-update.service

[Install]
WantedBy=timers.target
