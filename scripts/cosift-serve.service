[Unit]
Description=cosift pebble-serve
After=network-online.target ollama.service
Wants=network-online.target
# Be polite: pause if cosift-crawl is running (writer-lock conflict).
Conflicts=cosift-crawl.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
Environment=COSIFT_LOAD_HNSW=true
Environment=COSIFT_RATELIMIT_RPM=120
Environment=COSIFT_RATELIMIT_BURST=40
Environment=COSIFT_RATELIMIT_WHITELIST=104.28.216.88,127.0.0.1
ExecStart=/home/ubuntu/cosift -config /home/ubuntu/cosift.json pebble-serve -dir /home/ubuntu/cosift-data/pebble -addr 127.0.0.1:7777
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
