{
  auto_https off
  servers {
    protocols h1 h2
  }
}
:443 {
  tls /etc/caddy/cert.pem /etc/caddy/key.pem
  reverse_proxy 127.0.0.1:7777 {
    # Iter 431: active health probe on /healthz (sub-ms) lets Caddy mark
    # cosift unhealthy the moment it goes down and return a fast 502
    # instead of holding the request for 90s of retry. Cloudflare then
    # serves its own error page (much better UX than a 522).
    health_uri      /healthz
    health_interval 1s
    health_timeout  1s
    # Short passive retry budget for the rare race where health-check
    # hasnt run yet but a request hits a draining upstream.
    lb_try_duration 5s
    lb_try_interval 250ms
    fail_duration   5s
  }
  encode gzip
  request_body {
    max_size 50MB
  }
}
:80 {
  redir https://192.222.56.72{uri} permanent
}
