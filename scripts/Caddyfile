cosift.pilotprotocol.network {
  reverse_proxy 127.0.0.1:7777 {
    health_uri      /healthz
    health_interval 1s
    health_timeout  1s
    lb_try_duration 5s
    lb_try_interval 250ms
    fail_duration   5s
  }
  encode gzip
  request_body {
    max_size 50MB
  }
}

:80 {
  redir https://cosift.pilotprotocol.network{uri} permanent
}
